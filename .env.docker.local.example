APP_PORT=3002

# PostgreSQL runs in a separate Docker container on this host
# and publishes port 5432 on the host.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USERNAME=monitoring
DB_PASSWORD=CHANGE_ME
DB_NAME=monitoring

# Temporary ADMIN identity for manual Nomad pull.
CURRENT_USER_ID=1
CURRENT_USER_NAME=Infrastructure Admin
CURRENT_USER_ROLE=ADMIN

# Monitoring Service API Basic Auth.
MONITORING_BASIC_AUTH_USERNAME=CHANGE_ME
MONITORING_BASIC_AUTH_PASSWORD=CHANGE_ME

ALERTING_POLL_INTERVAL_MS=1000
ALERT_REMINDER_INTERVAL_MS=60000

# Alert webhook; token is sent as "Authorization: Bearer <token>".
ALERT_WEBHOOK_URL=http://10.59.179.182:8080/api/v1/webhook/alerts
ALERT_WEBHOOK_TOKEN=CHANGE_ME


NOMAD_ENABLED=true
NOMAD_PULL_CRON="*/15 * * * * *"
NOMAD_PULL_CRON_TZ=Asia/Jakarta
NOMAD_PULL_RUN_ON_START=true
NOMAD_REQUEST_TIMEOUT_MS=10000
NOMAD_TLS_REJECT_UNAUTHORIZED=false
NOMAD_TLS_CA_FILE=
