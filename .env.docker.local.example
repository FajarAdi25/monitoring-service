# Windows host port -> container port 3002.
APP_HOST_PORT=3001
APP_PORT=3002

# MySQL runs natively on Windows.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
DB_NAME=monitoring

# Temporary ADMIN identity for manual Nomad pull.
CURRENT_USER_ID=1
CURRENT_USER_NAME=Infrastructure Admin
CURRENT_USER_ROLE=ADMIN

# Telegram Bot Service -> Monitoring Service Basic Auth.
MONITORING_BASIC_AUTH_USERNAME=CHANGE_ME
MONITORING_BASIC_AUTH_PASSWORD=CHANGE_ME

ALERTING_POLL_INTERVAL_MS=1000
ALERT_REMINDER_INTERVAL_MS=60000

# Telegram Bot Service runs natively on Windows port 3004.
ALERT_WEBHOOK_URL=http://host.docker.internal:3004/webhooks/alerts

NOMAD_ENABLED=true
NOMAD_PULL_CRON="*/15 * * * * *"
NOMAD_PULL_CRON_TZ=Asia/Jakarta
NOMAD_PULL_RUN_ON_START=true
NOMAD_REQUEST_TIMEOUT_MS=10000
NOMAD_TLS_REJECT_UNAUTHORIZED=false
NOMAD_TLS_CA_FILE=
