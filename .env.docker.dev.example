# Monitoring Service exposure on the Linux development server.
APP_BIND_IP=0.0.0.0
APP_HOST_PORT=3001
APP_PORT=3002

# MySQL runs outside Docker.
# If MySQL is on this same Linux server, compose maps host.docker.internal to
# the Docker host gateway. If MySQL is remote, replace DB_HOST with its DNS/IP.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=monitoring
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=monitoring

# Temporary ADMIN identity for the manual Nomad pull endpoint.
CURRENT_USER_ID=1
CURRENT_USER_NAME="Infrastructure Admin"
CURRENT_USER_ROLE=ADMIN

# Telegram Bot Service -> Monitoring Service Basic Auth.
MONITORING_BASIC_AUTH_USERNAME=telegram-bot
MONITORING_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_BOT_PASSWORD

ALERTING_POLL_INTERVAL_MS=1000
ALERT_REMINDER_INTERVAL_MS=60000

# Replace with Telegram Bot Service endpoint during integration testing.
ALERT_WEBHOOK_URL=http://127.0.0.1:3002/api/v1/webhooks/telegram/dummy

NOMAD_ENABLED=true
NOMAD_PULL_CRON="*/15 * * * * *"
NOMAD_PULL_CRON_TZ=Asia/Jakarta
NOMAD_PULL_RUN_ON_START=true
NOMAD_REQUEST_TIMEOUT_MS=10000
NOMAD_TLS_REJECT_UNAUTHORIZED=true
NOMAD_TLS_CA_FILE=
# Example: /app/certs/nomad-ca.pem

# Incident open/resolved webhook for third party integrations.
RELAY_WEBHOOK_URL=http://localhost/api/webhooks/monitoring/bLRUpcVhekzwGQVK
RELAY_WEBHOOK_API_KEY=abcd123