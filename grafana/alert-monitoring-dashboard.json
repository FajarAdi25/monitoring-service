          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  i.public_id AS \"Incident\",\n  i.severity AS \"Severity\",\n  c.cluster_name AS \"Cluster\",\n  c.site AS \"Site\",\n  i.source AS \"Source\",\n  i.type AS \"Type\",\n  i.resource_type AS \"Resource Type\",\n  COALESCE(i.resource_name, i.resource_key) AS \"Resource\",\n  i.message AS \"Message\",\n  i.opened_at AS \"Opened At\",\n  EXTRACT(EPOCH FROM ((NOW() AT TIME ZONE 'UTC') - i.opened_at)) AS \"Age\",\n  i.last_detected_at AS \"Last Detected\",\n  i.reminder_count AS \"Reminders\",\n  i.last_notification_at AS \"Last Notification\",\n  c.is_active AS \"Cluster Active\"\nFROM incidents i\nJOIN clusters c ON c.cluster_id = i.cluster_id\nWHERE i.status = 'OPEN'\n  AND c.site IN ($site)\n  AND i.cluster_id::text IN ($cluster)\n  AND i.severity IN ($severity)\n  AND i.source IN ($source)\n  AND ('__all' IN ($node) OR CASE i.resource_type\n    WHEN 'NODE' THEN i.resource_name\n    WHEN 'DRIVER' THEN i.context_json->>'nodeName'\n    WHEN 'ALLOCATION' THEN i.context_json->'currentAllocation'->>'NodeName'\n  END IN ($node))\nORDER BY\n  CASE i.severity WHEN 'CRITICAL' THEN 0 WHEN 'MAJOR' THEN 1 ELSE 2 END,\n  i.opened_at"
