    {
      "id": 11,
      "type": "timeseries",
      "title": "Opened vs Resolved",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(i.opened_at, $__interval, 0),\n  COUNT(*) AS \"Opened\"\nFROM incidents i\nJOIN clusters c ON c.cluster_id = i.cluster_id\nWHERE $__timeFilter(i.opened_at)\n  AND c.site IN ($site)\n  AND i.cluster_id::text IN ($cluster)\n  AND i.severity IN ($severity)\n  AND i.source IN ($source)\n  AND ('__all' IN ($node) OR CASE i.resource_type\n    WHEN 'NODE' THEN i.resource_name\n    WHEN 'DRIVER' THEN i.context_json->>'nodeName'\n    WHEN 'ALLOCATION' THEN i.context_json->'currentAllocation'->>'NodeName'\n  END IN ($node))\n  AND i.status IN ($status)\nGROUP BY 1\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(i.resolved_at, $__interval, 0),\n  COUNT(*) AS \"Resolved\"\nFROM incidents i\nJOIN clusters c ON c.cluster_id = i.cluster_id\nWHERE i.status = 'RESOLVED'\n  AND $__timeFilter(i.resolved_at)\n  AND c.site IN ($site)\n  AND i.cluster_id::text IN ($cluster)\n  AND i.severity IN ($severity)\n  AND i.source IN ($source)\n  AND ('__all' IN ($node) OR CASE i.resource_type\n    WHEN 'NODE' THEN i.resource_name\n    WHEN 'DRIVER' THEN i.context_json->>'nodeName'\n    WHEN 'ALLOCATION' THEN i.context_json->'currentAllocation'->>'NodeName'\n  END IN ($node))\n  AND i.status IN ($status)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
