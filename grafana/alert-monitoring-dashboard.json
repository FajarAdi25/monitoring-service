    {
      "id": 10,
      "type": "timeseries",
      "title": "Incidents Opened by Severity",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(i.opened_at, $__interval, 0),\n  i.severity AS metric,\n  COUNT(*) AS value\nFROM incidents i\nJOIN clusters c ON c.cluster_id = i.cluster_id\nWHERE $__timeFilter(i.opened_at)\n  AND c.site IN ($site)\n  AND i.cluster_id::text IN ($cluster)\n  AND i.severity IN ($severity)\n  AND i.source IN ($source)\n  AND ('__all' IN ($node) OR CASE i.resource_type\n    WHEN 'NODE' THEN i.resource_name\n    WHEN 'DRIVER' THEN i.context_json->>'nodeName'\n    WHEN 'ALLOCATION' THEN i.context_json->'currentAllocation'->>'NodeName'\n  END IN ($node))\n  AND i.status IN ($status)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
