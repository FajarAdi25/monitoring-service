    {
      "id": 6,
      "type": "stat",
      "title": "MTTR",
      "description": "Rata-rata resolution_time.duration_seconds untuk incident yang resolved dalam time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
