      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) FILTER (WHERE i.severity = 'CRITICAL') AS \"CRITICAL\",\n  COUNT(*) FILTER (WHERE i.severity = 'MAJOR') AS \"MAJOR\",\n  COUNT(*) FILTER (WHERE i.severity = 'WARNING') AS \"WARNING\"\nFROM incidents i\nJOIN clusters c ON c.cluster_id = i.cluster_id\nWHERE i.status = 'OPEN'\n  AND c.site IN ($site)\n  AND i.cluster_id::text IN ($cluster)\n  AND i.severity IN ($severity)\n  AND i.source IN ($source)\n  AND ('__all' IN ($node) OR CASE i.resource_type\n    WHEN 'NODE' THEN i.resource_name\n    WHEN 'DRIVER' THEN i.context_json->>'nodeName'\n    WHEN 'ALLOCATION' THEN i.context_json->'currentAllocation'->>'NodeName'\n  END IN ($node))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
