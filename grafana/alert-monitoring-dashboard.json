          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) FILTER (WHERE i.type = 'NODE_DOWN') AS \"NODE_DOWN\",\n  COUNT(*) FILTER (WHERE i.type = 'ALLOCATION_FAILED') AS \"ALLOCATION_FAILED\",\n  COUNT(*) FILTER (WHERE i.type = 'EVALUATION_BLOCKED') AS \"EVALUATION_BLOCKED\",\n  COUNT(*) FILTER (WHERE i.type = 'DRIVER_UNHEALTHY') AS \"DRIVER_UNHEALTHY\",\n  COUNT(*) FILTER (WHERE i.type = 'SSL_CERTIFICATE_EXPIRING') AS \"SSL_CERTIFICATE_EXPIRING\"\nFROM incidents i\nJOIN clusters c ON c.cluster_id = i.cluster_id\nWHERE i.status = 'OPEN'\n  AND c.site IN ($site)\n  AND i.cluster_id::text IN ($cluster)\n  AND i.severity IN ($severity)\n  AND i.source IN ($source)\n  AND ('__all' IN ($node) OR CASE i.resource_type\n    WHEN 'NODE' THEN i.resource_name\n    WHEN 'DRIVER' THEN i.context_json->>'nodeName'\n    WHEN 'ALLOCATION' THEN i.context_json->'currentAllocation'->>'NodeName'\n  END IN ($node))"
