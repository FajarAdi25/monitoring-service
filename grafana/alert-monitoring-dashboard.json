          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  c.cluster_name AS \"Cluster\",\n  i.resource_type AS \"Resource Type\",\n  COALESCE(i.resource_name, i.resource_key) AS \"Resource\",\n  i.type AS \"Type\",\n  COUNT(*) AS \"Incidents\",\n  MAX(i.opened_at) AS \"Last Opened\"\nFROM incidents i\nJOIN clusters c ON c.cluster_id = i.cluster_id\nWHERE $__timeFilter(i.opened_at)\n  AND c.site IN ($site)\n  AND i.cluster_id::text IN ($cluster)\n  AND i.severity IN ($severity)\n  AND i.source IN ($source)\n  AND ('__all' IN ($node) OR CASE i.resource_type\n    WHEN 'NODE' THEN i.resource_name\n    WHEN 'DRIVER' THEN i.context_json->>'nodeName'\n    WHEN 'ALLOCATION' THEN i.context_json->'currentAllocation'->>'NodeName'\n  END IN ($node))\n  AND i.status IN ($status)\nGROUP BY c.cluster_name, i.resource_type, COALESCE(i.resource_name, i.resource_key), i.type\nORDER BY \"Incidents\" DESC\nLIMIT 10"
        }
