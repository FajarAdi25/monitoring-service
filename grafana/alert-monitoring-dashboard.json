    {
      "id": 8,
      "type": "stat",
      "title": "Nomad Nodes",
      "description": "Node Nomad dari monitoring_current_states. Active = state READY, Inactive = state selain READY.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 14,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) AS \"Total\",\n  COUNT(*) FILTER (WHERE m.state = 'READY') AS \"Active\",\n  COUNT(*) FILTER (WHERE m.state <> 'READY') AS \"Inactive\"\nFROM monitoring_current_states m\nJOIN clusters c ON c.cluster_id = m.cluster_id\nWHERE m.source = 'NOMAD'\n  AND m.resource_type = 'NODE'\n  AND c.site IN ($site)\n  AND m.cluster_id::text IN ($cluster)\n  AND ('__all' IN ($node) OR m.resource_name IN ($node))"
        }
      ],
