{
  "info": {
    "name": "Alert Management API v2.0.0",
    "description": "Postman collection for Alert Management multi-cluster Nomad API v2.0.0.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "clusterId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Nomad",
      "item": [
        {
          "name": "Get Nodes All Clusters",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/nomad/nodes"
          }
        },
        {
          "name": "Get Nodes By Cluster",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/nomad/nodes?cluster={{clusterId}}"
          }
        },
        {
          "name": "Manual Pull All Clusters",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/nomad/pull"
          }
        },
        {
          "name": "Manual Pull By Cluster",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/nomad/pull?cluster={{clusterId}}"
          }
        }
      ]
    },
    {
      "name": "Monitoring",
      "item": [
        {
          "name": "Current State",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/monitoring/current"
          }
        },
        {
          "name": "Snapshots",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/monitoring/snapshots"
          }
        }
      ]
    },
    {
      "name": "Incident",
      "item": [
        {
          "name": "List Incidents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/incidents"
          }
        },
        {
          "name": "Recent Incidents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/incidents/recent"
          }
        },
        {
          "name": "Resolved Incidents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/incidents/resolved"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Summary All Clusters",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/dashboard/summary"
          }
        },
        {
          "name": "Summary By Cluster",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/dashboard/summary?cluster={{clusterId}}"
          }
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/dashboard/health"
          }
        }
      ]
    }
  ]
}