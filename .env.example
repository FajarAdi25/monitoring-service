APP_PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=monitoring
DB_PASSWORD=monitoring
DB_NAME=monitoring

# Temporary local user for the ADMIN-only manual Nomad pull endpoint.
# Telegram ACK/POSTPONE do not use this identity.
CURRENT_USER_ID=1
CURRENT_USER_NAME=Infrastructure Admin
CURRENT_USER_ROLE=ADMIN

# Telegram Bot Service -> Monitoring Service Basic authentication.
# Configure the same username/password in Telegram Bot Service.
# Use HTTPS in production because Basic Auth credentials are only Base64-encoded.
MONITORING_BASIC_AUTH_USERNAME=telegram-bot
MONITORING_BASIC_AUTH_PASSWORD=

# Alert worker checks due notifications every second.
ALERTING_POLL_INTERVAL_MS=1000
# OPEN incidents are reminded every 1 minute.
ALERT_REMINDER_INTERVAL_MS=60000

# Alert delivery example. By default alerts POST to the dummy Telegram webhook
# served by this same application.
ALERT_WEBHOOK_URL=http://127.0.0.1:3000/api/v1/webhooks/telegram/dummy

# Nomad puller
NOMAD_ENABLED=true
# node-cron supports a seconds field. Pull Nomad every 15 seconds.
NOMAD_PULL_CRON="*/15 * * * * *"
NOMAD_PULL_CRON_TZ=Asia/Jakarta
NOMAD_PULL_RUN_ON_START=true
NOMAD_REQUEST_TIMEOUT_MS=10000
NOMAD_TLS_REJECT_UNAUTHORIZED=true
NOMAD_TLS_CA_FILE=

# Incident open/resolved webhook for third party integrations.
RELAY_WEBHOOK_URL=http://localhost/api/webhooks/monitoring/bLRUpcVhekzwGQVK
RELAY_WEBHOOK_API_KEY=abcd123
